# Copy this file to .env:   cp .env.example .env      (.env is in .gitignore - it is never committed)
#
# Local Python run: put the secrets (GEMINI_API_KEY, IMAP_PASSWORD) here.
# Docker run:       put the secrets in files under secrets/ instead and leave them empty here.
#                   e.g. secrets/gemini_api_key, secrets/imap_password (see README, "Quick start: Docker").

# ---- The basics ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Your mailbox. Leave IMAP_USERNAME empty to run on the built-in mock inbox.
MAIL_PROFILE=gmail             # gmail | outlook | yahoo  (server settings come from config/<profile>.env)
IMAP_USERNAME=                 # your email address
IMAP_PASSWORD=                 # an app password, not your normal password (README section 5)

# Clean replies for these categories are sent automatically; everything else is saved as a draft.
# AUTO_SEND=false              # uncomment to only save drafts, never send
# AUTO_SEND_CATEGORIES=customer_complaint,kyc_document

# Free Gemini keys allow only a few requests per minute (0 = no limit).
LLM_REQUESTS_PER_MINUTE=2

# ---- Advanced (the defaults are shown; uncomment to change) ----
# LLM
# LLM_PROVIDER=gemini                    # or huggingface
# GEMINI_MODEL=gemini-2.5-flash
# HF_TOKEN=                              # for huggingface: https://huggingface.co/settings/tokens
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_TIMEOUT_SECONDS=90
# LLM_INPUT_PRICE_PER_MTOK=0             # USD per million tokens, for the cost estimate (0 = off)
# LLM_OUTPUT_PRICE_PER_MTOK=0

# Mailbox
# IMAP_HOST=                             # only for a server without a profile (then also SMTP_HOST)
# IMAP_PORT=993
# SMTP_HOST=
# SMTP_PORT=465
# IMAP_AUTH=password                     # or xoauth2 (set by the outlook profile)
# IMAP_OAUTH_TOKEN=                      # OAuth2 access token, only for IMAP_AUTH=xoauth2
# IMAP_DRAFTS_FOLDER=                    # only if the server does not mark its Drafts folder
# MAIL_ADDRESS=                          # only if your address is different from IMAP_USERNAME
# MAIL_DAYS=7                            # how far back to look for unread mail
# APPLY_LABELS=true                      # add Triage/* labels (the outlook profile turns this off)
# MAX_SENDS_PER_RUN=5

# Guardrail limits
# MAX_EMAILS=50
# MAX_STEPS=6
# MAX_LLM_CALLS_PER_RUN=200
# MAX_ATTEMPTS=3
# MAX_BODY_CHARS=8000
# MIN_CONFIDENCE=0.6

# Reply placeholders (filled in by code, never by the LLM)
# TICKET_PREFIX=LTFS
# SLA_TEXT=within 2 business days
# SIGNATURE="Regards,\nCustomer Care Team"

# Tracing: none | console | otlp (Docker sets otlp)
# OTEL_TRACES_EXPORTER=none
# OTEL_CAPTURE_CONTENT=false             # true = record full LLM prompts/replies (customer email text). Docker: true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Docker only
# MAIL_LIMIT=20                          # emails per run
# WATCH_INTERVAL=1500                    # max seconds between mailbox checks
# GRAFANA_ADMIN_PASSWORD=                # set before the first start to replace the default "password"
