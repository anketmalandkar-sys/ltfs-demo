# Copy this file to .env and fill in what you need:   cp .env.example .env
# .env is in .gitignore - it is never committed.
#
# Where do secrets go?
#   - Local Python run: put them in this file (GEMINI_API_KEY, IMAP_PASSWORD, ...).
#   - Docker run:       put them in files under secrets/ instead, and keep this file free of secrets.
#                       See README, "Run with Docker".

# ---- LLM: gemini | huggingface ----
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only for LLM_PROVIDER=huggingface. Token from https://huggingface.co/settings/tokens
# (needs the "Inference Providers" permission)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# Max LLM requests per minute (0 = no limit). Free Gemini keys allow only a few per minute.
LLM_REQUESTS_PER_MINUTE=2
# Seconds to wait for one LLM answer before trying again.
LLM_TIMEOUT_SECONDS=90
# Optional cost estimate: your model's price in USD per million tokens. 0 = do not estimate.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# ---- Mailbox (only for --source imap) ----
# Server settings come from a profile: --profile gmail | outlook | yahoo (see config/*.env).
# For any other provider, skip --profile and set IMAP_HOST (and IMAP_PORT if it is not 993).
IMAP_USERNAME=
# IMAP_AUTH=password          # or xoauth2 (Outlook / Microsoft 365)
IMAP_PASSWORD=                # password or app password (Gmail: https://myaccount.google.com/apppasswords)
# IMAP_OAUTH_TOKEN=           # OAuth2 access token, only for IMAP_AUTH=xoauth2
# IMAP_DRAFTS_FOLDER=         # only if the server does not mark its Drafts folder
# MAIL_ADDRESS=               # only if your email address is different from IMAP_USERNAME
MAIL_DAYS=7

# ---- Sending replies (off by default: replies are only saved as drafts) ----
# When on, a reply is sent only for these categories, only if no guardrail raised a flag,
# and at most MAX_SENDS_PER_RUN times per run.
AUTO_SEND=false
AUTO_SEND_CATEGORIES=customer_complaint,kyc_document
MAX_SENDS_PER_RUN=5
# SMTP_HOST and SMTP_PORT come from the profile. The login is the same as for IMAP.

# ---- Guardrail limits ----
MAX_EMAILS=50
MAX_STEPS=6
MAX_LLM_CALLS_PER_RUN=200
MAX_ATTEMPTS=3
MAX_BODY_CHARS=8000
MIN_CONFIDENCE=0.6

# ---- Reply placeholders (filled in by code, never by the LLM) ----
TICKET_PREFIX=LTFS
SLA_TEXT=within 2 business days
SIGNATURE="Regards,\nCustomer Care Team"

# ---- Tracing: none | console | otlp ----
OTEL_TRACES_EXPORTER=none            # Docker sets otlp (sends traces, metrics and logs to the Collector)
# true = also record the full LLM prompts and replies (these contain customer email text).
# Docker turns this on by default for the demo; set false here to turn it off.
OTEL_CAPTURE_CONTENT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Docker only ----
# MAIL_PROFILE=gmail             # provider profile for `docker compose up`
# MAIL_LIMIT=20                  # emails per run
# WATCH_INTERVAL=1500            # max seconds between mailbox checks
# GRAFANA_ADMIN_PASSWORD=        # set before the first start to replace the default "password"
