# Copy this file to .env (./start.sh does it for you). .env is in .gitignore - it is never committed.
#
# Put the real values here. For Docker, ./start.sh builds them into an encrypted keystore in the image, whose
# copy of .env has only references (GEMINI_API_KEY=keystore:GEMINI_API_KEY). This file is not changed.
#
# Keep comments on their own line: Docker reads "KEY=  # text" as the value "# text".

# ---- The basics ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Your mailbox. Leave IMAP_USERNAME empty to run on the built-in mock inbox.
# MAIL_PROFILE: gmail, outlook or yahoo (server settings come from config/<profile>.env)
MAIL_PROFILE=gmail
# Your email address
IMAP_USERNAME=
# An app password, not your normal password (README section 5)
IMAP_PASSWORD=

# Clean replies for these categories are sent automatically; everything else is saved as a draft.
# Uncomment AUTO_SEND=false to only save drafts, never send.
# AUTO_SEND=false
# AUTO_SEND_CATEGORIES=customer_complaint,kyc_document

# Free Gemini keys allow only a few requests per minute (0 = no limit).
LLM_REQUESTS_PER_MINUTE=2

# ---- Advanced (the defaults are shown; uncomment to change) ----
# LLM: gemini or huggingface
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# For huggingface: a token from https://huggingface.co/settings/tokens ("Inference Providers" permission)
# HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_TIMEOUT_SECONDS=90
# Cost estimate in USD per million tokens (0 = off)
# LLM_INPUT_PRICE_PER_MTOK=0
# LLM_OUTPUT_PRICE_PER_MTOK=0

# Mailbox. IMAP_HOST and SMTP_HOST only for a server without a profile.
# IMAP_HOST=
# IMAP_PORT=993
# SMTP_HOST=
# SMTP_PORT=465
# IMAP_AUTH: password, or xoauth2 (set by the outlook profile); IMAP_OAUTH_TOKEN only for xoauth2
# IMAP_AUTH=password
# IMAP_OAUTH_TOKEN=
# Only if the server does not mark its Drafts folder
# IMAP_DRAFTS_FOLDER=
# Only if your address is different from IMAP_USERNAME
# MAIL_ADDRESS=
# How far back to look for unread mail
# MAIL_DAYS=7
# Add Triage/* labels (the outlook profile turns this off)
# APPLY_LABELS=true
# MAX_SENDS_PER_RUN=5

# Guardrail limits
# MAX_EMAILS=50
# MAX_STEPS=6
# MAX_LLM_CALLS_PER_RUN=200
# MAX_ATTEMPTS=3
# MAX_BODY_CHARS=8000
# MIN_CONFIDENCE=0.6

# Reply placeholders (filled in by code, never by the LLM)
# TICKET_PREFIX=LTFS
# SLA_TEXT=within 2 business days
# SIGNATURE="Regards,\nCustomer Care Team"

# Tracing: none, console or otlp (Docker sets otlp).
# OTEL_CAPTURE_CONTENT=true records full LLM prompts/replies (customer email text); Docker turns it on.
# OTEL_TRACES_EXPORTER=none
# OTEL_CAPTURE_CONTENT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Docker only: emails per run, max seconds between mailbox checks, Grafana password (set before the first start)
# MAIL_LIMIT=20
# WATCH_INTERVAL=1500
# GRAFANA_ADMIN_PASSWORD=
