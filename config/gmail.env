# Gmail / Google Workspace. Non-secret settings only - this file is baked into the Docker image.
# Login: your address + an App Password (needs 2-Step Verification): https://myaccount.google.com/apppasswords
# Put the App Password in IMAP_PASSWORD (.env for local runs, secrets/imap_password for Docker).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_AUTH=password
# The Drafts folder is found by its \Drafts flag, whatever the account language.
# Sending (on unless AUTO_SEND=false) uses the same App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
