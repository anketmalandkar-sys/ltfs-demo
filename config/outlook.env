# Outlook.com / Microsoft 365. Non-secret settings only - this file is baked into the Docker image.
# Microsoft has turned off password login for IMAP, so this uses OAuth2 (XOAUTH2).
# Get an access token with the IMAP.AccessAsUser.All scope (e.g. MSAL device-code flow) and put it in
# IMAP_OAUTH_TOKEN (.env for local runs, secrets/imap_oauth_token for Docker). Tokens last about an hour;
# the agent re-reads the secret every cycle, so whatever refreshes it can just overwrite the file.
# Outlook does not allow custom IMAP keywords, so --apply-labels is not supported here.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_AUTH=xoauth2
# Sending (only with AUTO_SEND=true) uses the same token; it needs the SMTP.Send scope too.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
