# Outlook.com / Microsoft 365. Non-secret settings only - this file is baked into the Docker image.
# Microsoft has turned off password login for IMAP, so this uses OAuth2 (XOAUTH2).
# Get an access token with the IMAP.AccessAsUser.All scope (e.g. MSAL device-code flow) and put it in
# IMAP_OAUTH_TOKEN in .env. Tokens last about an hour;
# the agent re-reads the secret every cycle, so whatever refreshes it can just store the new one.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_AUTH=xoauth2
# Outlook does not allow custom IMAP keywords, so labels are off.
APPLY_LABELS=false
# Sending (on unless AUTO_SEND=false) uses the same token; it needs the SMTP.Send scope too.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
