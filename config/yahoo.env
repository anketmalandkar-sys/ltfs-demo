# Yahoo Mail. Non-secret settings only - this file is baked into the Docker image.
# Login: your address + an app password (Account security > Generate app password).
# Put it in IMAP_PASSWORD in .env.
IMAP_HOST=imap.mail.yahoo.com
IMAP_PORT=993
IMAP_AUTH=password
# Sending (on unless AUTO_SEND=false) uses the same app password.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
